# LLM generation
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o-mini

# Local RAG
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5
RAG_RERANKER_ENABLED=false
RAG_HYBRID_ENABLED=true
RAG_CHAR_WEIGHT=0.35
RAG_REWRITE_QUERIES=1

# Optional PostgreSQL storage
PG_ENABLED=false
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=pcb_app
PG_PASSWORD=change-me
PG_DBNAME=pcb_rag

# Optional embedding/vector retrieval
EMBEDDING_ENABLED=false
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_ENDPOINT=https://api.openai.com/v1/embeddings
RAG_VECTOR_ENABLED=false
RAG_VECTOR_TOP_K=8
RAG_VECTOR_THRESHOLD=0.15

# Optional Chroma storage
CHROMA_ENABLED=false
CHROMA_PATH=backend/data/chroma
CHROMA_COLLECTION=pcb_rag
