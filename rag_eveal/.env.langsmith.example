LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=replace-with-your-langsmith-api-key
LANGSMITH_PROJECT=pcb-rag-evaluation

OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_API_KEY=replace-with-your-model-api-key
OPENAI_MODEL=replace-with-your-chat-model

# 每百万 token 的实际价格。请以模型供应商当前价格为准；配置后 LangSmith 才能得到精确 total_cost。
OPENAI_INPUT_COST_PER_MILLION=
OPENAI_CACHED_INPUT_COST_PER_MILLION=
OPENAI_OUTPUT_COST_PER_MILLION=

# 可选：配置支持中英双语的 embedding 服务后，评估会融合向量与本地稀疏检索结果。
RAG_EVAL_VECTOR_ENABLED=true
CHROMA_ENABLED=false
EMBEDDING_ENDPOINT=https://api.example.com/v1/embeddings
EMBEDDING_API_KEY=replace-with-your-embedding-api-key
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
